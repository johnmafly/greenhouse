{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johnmafly/greenhouse/schemas/claims.schema.json",
  "title": "Greenhouse claims ledger",
  "description": "claims.yaml in a project repo: every public factual claim with its source and a verbatim supporting quote.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "where", "source_url", "quote", "checked"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "claim": { "type": "string", "minLength": 1 },
          "where": {
            "description": "Routes or files where the claim appears, e.g. /docs/comparison/.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "quote": { "type": "string", "minLength": 1 },
          "checked": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
