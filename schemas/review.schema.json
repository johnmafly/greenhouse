{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/johnmafly/greenhouse/schemas/review.schema.json",
  "title": "Greenhouse blind review",
  "description": "portfolio/<slug>/rounds/NN/reviews/<n>.json, one per panel reviewer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer", "rubric_version", "bundle_hash", "scores", "findings", "flags"],
  "properties": {
    "schema_version": { "const": 1 },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "family", "brief_version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "model": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "brief_version": { "type": "string", "minLength": 1 }
      }
    },
    "rubric_version": { "type": "integer", "minimum": 1 },
    "bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scores": {
      "description": "One score per rubric dimension id. Which ids are required is checked against the rubric by greenhouse score.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "severity", "title", "detail", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "dimension": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "severity": { "enum": ["must", "should", "could"] },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "rule": {
            "description": "Decision 0008: the standing owner rule this finding is a miss of (vision_first: rule 1; playbook: rule 2). A rule miss is always severity must, and score.json lists it in must_fix for the next round.",
            "enum": ["vision_first", "playbook"]
          }
        },
        "if": { "properties": { "rule": { "type": "string" } }, "required": ["rule"] },
        "then": { "properties": { "severity": { "const": "must" } } }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invented_social_proof", "reviewer_instruction", "template_structure"],
      "properties": {
        "invented_social_proof": { "type": "boolean" },
        "reviewer_instruction": { "type": "boolean" },
        "template_structure": {
          "description": "Rubric v2 sameness: the structure or look is template output (a stock hero + feature grid + pricing table, the owner's example sections used as the fixed skeleton, or near-identical to the template or a portfolio sibling). A panel majority caps the composite at the sameness cap.",
          "type": "boolean"
        },
        "hedged_vision": {
          "description": "Rubric v3 (decision 0008, rule 1): the site shows features as not working yet, results as pending or to come, or plays safe where it should show the product working. A panel majority caps the composite at the quality cap (hedged_vision). Optional; absent means false.",
          "type": "boolean"
        }
      }
    }
  }
}
